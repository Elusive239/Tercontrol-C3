{
  "dependency-search-paths": [ "lib" ],
  "dependencies": ["tc" ],

  "langrev": "1",
  "warnings": [ "no-unused" ],
  "authors": [ "Elusive239 <@elusive-noir.bsky.social>" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "cc": "gcc",
  "output": "build",
  "targets": {
    "main": {
      "type": "executable"
    }
  },
  "cpu": "generic",
  "opt": "O5",
  "optsize": "none",
  "panic-msg": false,
  "optlevel": "max",
  "single-module": true,
  "debug-info": "none"
} 